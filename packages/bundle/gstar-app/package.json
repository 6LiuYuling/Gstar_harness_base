{
  "name": "@deepseek-ai/dsh-gstar-app",
  "description": "GSTAR profile overlay replacing the standard chat shell with the GSTAR spatiotemporal data-asset workspace",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6LiuYuling/Gstar_harness_base.git",
    "directory": "packages/bundle/gstar-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-gstar": "workspace:^",
    "@deepseek-ai/dsh-gstar-client-remotes": "workspace:^",
    "@deepseek-ai/dsh-gstar-cesium-assets": "workspace:^",
    "@deepseek-ai/dsh-gstar-site": "workspace:^",
    "@deepseek-ai/dsh-gstar-site-workspace": "workspace:^",
    "@deepseek-ai/dsh-gstar-spatial": "workspace:^",
    "@deepseek-ai/dsh-gstar-spatial-storage": "workspace:^",
    "@deepseek-ai/dsh-gstar-tool-spatial-query": "workspace:^",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
